<section class="bookmark-manager" aria-label="Bookmark manager">
  <form id="add-bookmark">
    <div class="field">
      <label for="url">Link to save</label>
      <input
        id="url"
        name="url"
        type="text"
        inputmode="url"
        autocomplete="url"
        spellcheck="false"
        placeholder="example.com"
        aria-describedby="url-hint bookmark-status"
        required
      />
    </div>
    <button type="submit">Add bookmark</button>
  </form>

  <p id="url-hint" class="hint">A secure <code>https://</code> link is added automatically when needed.</p>
  <p id="bookmark-status" class="status" role="status" aria-live="polite" hidden></p>

  <p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

  <div id="list-header" class="list-header" hidden>
    <h2 class="list-title">Saved bookmarks</h2>
    <button id="clear-all" type="button" class="clear">Clear all</button>
  </div>

  <ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite"></ul>
</section>

<style>
  .bookmark-manager {
    --bookmark-accent: #147a5b;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(ellipse at top right, color-mix(in srgb, var(--bookmark-accent) 9%, transparent), transparent 55%),
      color-mix(in srgb, currentColor 2%, transparent);
    box-shadow: 0 1rem 2.5rem color-mix(in srgb, currentColor 6%, transparent);
  }

  form {
    display: flex;
    align-items: end;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin: 0 0 0.35rem;
  }

  .field { flex: 1 1 15rem; }

  input { width: 100%; }
  input:focus-visible { border-color: var(--bookmark-accent); }

  form button {
    background: var(--bookmark-accent);
  }

  .hint {
    margin: 0 0 1.5rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .status {
    margin: 0 0 1rem;
    color: var(--bookmark-accent);
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  .status[data-error="true"] { color: #b42318; }

  .list-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.5rem 0;
  }

  .list-title {
    margin: 0;
    font-size: 1rem;
    font-family: var(--font-head);
  }

  .clear,
  .copy {
    background: transparent;
    color: inherit;
    border: 1px solid var(--border);
    padding: 0.35rem 0.7rem;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .clear:hover,
  .copy:hover { border-color: currentColor; }

  ul {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  li.bookmark {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem;
    padding: 0.75rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: color-mix(in srgb, currentColor 2%, transparent);
  }

  .entry {
    display: flex;
    align-items: center;
    flex: 1 1 15rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .url {
    min-width: 0;
    color: var(--accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    overflow-wrap: anywhere;
  }

  .separator {
    flex: 0 0 auto;
    color: var(--muted);
    white-space: pre;
  }

  .slug {
    flex: 0 0 auto;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bookmark-accent) 14%, transparent);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .empty {
    margin: 0;
    padding: 1.5rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    color: var(--muted);
    text-align: center;
  }

  @media (max-width: 30rem) {
    .bookmark-manager { padding: 1rem; }
    form button { width: 100%; }
  }
</style>

<script>
  import {
    createSlug,
    formatBookmark,
    normalizeUrl,
    parseBookmarks,
    type Bookmark,
  } from '../lib/bookmarks';

  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const urlInput = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearButton = document.getElementById('clear-all');
  const status = document.getElementById('bookmark-status');

  function setStatus(message: string, isError = false) {
    if (!(status instanceof HTMLElement)) return;
    status.textContent = message;
    status.dataset.error = String(isError);
    status.hidden = !message;
  }

  function loadBookmarks(): Bookmark[] {
    try {
      return parseBookmarks(localStorage.getItem(storageKey));
    } catch {
      setStatus('Browser storage is unavailable. Bookmarks will only last for this visit.', true);
      return [];
    }
  }

  let bookmarks = loadBookmarks();

  function saveBookmarks(): boolean {
    try {
      localStorage.setItem(storageKey, JSON.stringify(bookmarks));
      setStatus('');
      return true;
    } catch {
      setStatus('Could not save to browser storage. This bookmark may not survive a reload.', true);
      return false;
    }
  }

  function renderBookmarks() {
    if (!(list instanceof HTMLUListElement)
      || !(emptyState instanceof HTMLElement)
      || !(listHeader instanceof HTMLElement)) return;

    list.replaceChildren();
    for (const bookmark of bookmarks) {
      const item = document.createElement('li');
      item.className = 'bookmark';

      const entry = document.createElement('div');
      entry.className = 'entry';

      const link = document.createElement('a');
      link.className = 'url';
      link.href = bookmark.url;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.textContent = bookmark.url;

      const separator = document.createElement('span');
      separator.className = 'separator';
      separator.setAttribute('aria-hidden', 'true');
      separator.textContent = ' :: ';

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = bookmark.slug;

      const copyButton = document.createElement('button');
      copyButton.className = 'copy';
      copyButton.type = 'button';
      copyButton.textContent = 'Copy';
      copyButton.setAttribute('aria-label', `Copy ${bookmark.slug}`);
      copyButton.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(bookmark.slug);
          setStatus(`Copied ${bookmark.slug} to the clipboard.`);
        } catch {
          setStatus('Could not access the clipboard. Select and copy the slug instead.', true);
        }
      });

      entry.append(link, separator, slug);
      item.append(entry, copyButton);
      list.append(item);
    }

    const hasBookmarks = bookmarks.length > 0;
    emptyState.hidden = hasBookmarks;
    listHeader.hidden = !hasBookmarks;
  }

  renderBookmarks();

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    if (!(urlInput instanceof HTMLInputElement)) {
      setStatus('The bookmark URL field is unavailable.', true);
      return;
    }

    const url = normalizeUrl(urlInput.value);
    if (!url) {
      setStatus('Enter a valid http:// or https:// web address.', true);
      urlInput.focus();
      return;
    }

    let slug = createSlug();
    while (bookmarks.some((bookmark) => bookmark.slug === slug)) {
      slug = createSlug();
    }

    const bookmark = { url, slug };
    bookmarks = [...bookmarks, bookmark];
    const saved = saveBookmarks();
    renderBookmarks();
    urlInput.value = '';
    urlInput.focus();
    if (saved) setStatus(`Saved ${formatBookmark(bookmark)}.`);
  });

  clearButton?.addEventListener('click', () => {
    if (bookmarks.length === 0 || !window.confirm('Clear all saved bookmarks?')) return;
    bookmarks = [];
    const saved = saveBookmarks();
    renderBookmarks();
    if (saved) setStatus('All bookmarks cleared.');
  });
</script>
